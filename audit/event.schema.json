{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/secure-llm-platform-reference/audit-event.schema.json",
  "title": "Reference prompt audit event",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "request_id",
    "actor_pseudonym",
    "prompt_sha256",
    "prompt_characters",
    "confidence",
    "source_ids",
    "refused"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_pseudonym": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_characters": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "refused": {
      "type": "boolean"
    },
    "policy_verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      },
      "uniqueItems": true
    },
    "prompt": {
      "type": "string",
      "maxLength": 4000
    },
    "corpus": {
      "type": "object",
      "required": [
        "corpus_id",
        "corpus_version",
        "manifest_sha256"
      ],
      "properties": {
        "corpus_id": {
          "type": "string"
        },
        "corpus_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
