# Public-safe local defaults. Do not add real credentials to this file.
RAG_INDEX_PATH=/app/generated/index.json
RAG_GATEWAY_MODE=demo
RAG_MIN_CONFIDENCE=0.34
RAG_TOP_K=3
RUNTIME_LOG_PATH=/var/log/reference/runtime/runtime.jsonl
AUDIT_LOG_PATH=/var/log/reference/audit/audit.jsonl
AUDIT_INCLUDE_PROMPT=false
AUDIT_PSEUDONYM_SALT=replace-with-at-least-32-random-characters
GUARDRAILS_ENABLED=true
# presidio = shared Presidio containers; regex = dependency-free fallback
PII_BACKEND=presidio
PRESIDIO_ANALYZER_URL=http://127.0.0.1:5002
PRESIDIO_ANONYMIZER_URL=http://127.0.0.1:5001
# Required for --profile gateway (LiteLLM). Generate a long random value.
LITELLM_MASTER_KEY=replace-with-a-long-random-value
# Model behind LiteLLM; the default points at a local Ollama-style server.
LITELLM_UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1
LITELLM_UPSTREAM_MODEL=openai/llama3.1
LITELLM_UPSTREAM_API_KEY=not-needed-for-local
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_COMPATIBLE_MODEL=local-model
OPENAI_COMPATIBLE_API_KEY=replace-with-a-local-secret

# Optional Entra ID / OAuth2 Proxy front door.
ENTRA_TENANT_ID=replace-with-tenant-id
ENTRA_ALLOWED_GROUP_ID=replace-with-security-group-id
OAUTH2_PROXY_CLIENT_ID=replace-with-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-client-secret
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64url-secret
OAUTH2_PROXY_REDIRECT_URL=http://127.0.0.1:4180/oauth2/callback
OAUTH2_PROXY_COOKIE_SECURE=false
