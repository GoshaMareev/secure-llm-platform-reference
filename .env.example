# Public-safe local defaults. Do not add real credentials to this file.
RAG_INDEX_PATH=/app/generated/index.json
RAG_GATEWAY_MODE=demo
RAG_MIN_CONFIDENCE=0.34
RAG_TOP_K=3
RUNTIME_LOG_PATH=/var/log/reference/runtime/runtime.jsonl
AUDIT_LOG_PATH=/var/log/reference/audit/audit.jsonl
AUDIT_INCLUDE_PROMPT=false
AUDIT_PSEUDONYM_SALT=replace-with-a-random-local-value
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_COMPATIBLE_MODEL=local-model
OPENAI_COMPATIBLE_API_KEY=replace-with-a-local-secret

FLUENT_BIT_IMAGE=fluent/fluent-bit:3.1.9
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
LOKI_IMAGE=grafana/loki:3.1.1

